      "id": "2df78ba9-b5c9-a84a-2312-902f6e8a4814",
      "source": "explanation",
      "text": "«قرب ذبابا لصنم»"
    },
    {
      "id": "f5e0a909-ac2d-a750-91c6-5c2c05aaade7",
      "source": "explanation",
      "text": "«أبى أن يقرب شيئا للصنم»"
    },
    {
      "id": "da5fd343-b6f1-ca1f-0ac7-4e9d3b3eeede",
      "source": "explanation",
      "text": "«فصل لربك وانحر»"
    },
    {
      "id": "1ba321f4-a52a-8707-ce06-f21ba86c41f1",
      "source": "explanation",
      "text": "«محدثا»"
    },
    {
      "id": "933e4b70-e0aa-c29c-a3e1-07a1c99a22dc",
      "source": "explanation",
      "text": "«بسحر مثله»"
    },
    {
      "id": "f508a223-2d15-9036-b3be-c8c4b67d067d",
      "source": "explanation",
      "text": "«التوكل»"
    },
    {
      "id": "cb699104-13a4-c4d2-b960-2d755a7acc1b",
      "source": "explanation",
      "text": "«كافر»"
    },
    {
      "id": "ee4c83d6-8ff1-1228-fd34-13c6dfb4de41",
      "source": "explanation",
      "text": "«اعتقاد أن النوء فاعل مستقل كفر أكبر؛ وهذا موافق لتقرير كتاب التوحيد»"
    },
    {
      "id": "272794ec-4981-1e28-3199-eceefebda72a",
      "source": "explanation",
      "text": "«مؤمن بالله كافر بالكوكب»"
    },
    {
      "id": "9056a278-446a-3482-7d53-beabdbbe4977",
      "source": "explanation",
      "text": "«الجاهلية»"
    },
    {
      "id": "c1563c51-2b17-512e-d449-8fec776f6137",
      "source": "explanation",
      "text": "«ينوطون بها أسلحتهم»"
    },
    {
      "id": "e0f8acf6-7366-94d9-1b93-49a30f6e34d2",
      "source": "explanation",
      "text": "«في حديث معاذ لما بعثه النبي إلى اليمن: بعد التوحيد يعلمهم أن الله افترض عليهم خمس صلوات»"
    },
    {
      "id": "056c9e25-4057-d6bb-40b9-68c439b5ee1b",
      "source": "explanation",
      "text": "«واتق دعوة المظلوم؛ فإنه ليس بينها وبين الله حجاب»"
    },
    {
      "id": "91eb89af-4c29-f159-bea4-d6c351552f31",
      "source": "explanation",
      "text": "«آبائكم»"
    },
    {
      "id": "39e56524-4689-3754-f7c7-7b3f5d144f9a",
      "source": "explanation",
      "text": "«الدهر»"
    },
    {
      "id": "a64e7df5-28bd-111f-29aa-8f7d514a7130",
      "source": "explanation",
      "text": "«أنا مدبر الزمان ومصرفه»"
    },
    {
      "id": "28aba9b7-8312-826c-21ed-ece8a4227029",
      "source": "explanation",
      "text": "«فلا تجعلوا لله أندادا»"
    },
    {
      "id": "8763fe64-4a49-cdc3-d58f-3f7d8649a5e8",
      "source": "explanation",
      "text": "«الله»"
    },
    {
      "id": "787a9a22-8783-d394-629e-58d3ec982663",
      "source": "explanation",
      "text": "«طلب الغوث وكشف الشدة»"
    },
    {
      "id": "320cbcbb-b9c0-5f5b-1e83-b6b6ba51200d",
      "source": "explanation",
      "text": "«تحويلا»"
    },
    {
      "id": "b47b0cea-8e73-b16f-d548-add5450fccf2",
      "source": "explanation",
      "text": "«الأرض»"
    },
    {
      "id": "32063d02-b9d8-1c56-c796-ce94db8df17b",
      "source": "explanation",
      "text": "«لله وحده»"
    },
    {
      "id": "2df4c9b6-6eb9-bfc1-8d78-ff092cdba9b5",
      "source": "explanation",
      "text": "«صنمهم»"
    },
    {
      "id": "fa9ff40e-4c9d-a6e4-3593-d3a8083e5345",
      "source": "explanation",
      "text": "«الشرك»"
    },
    {
      "id": "649bc12b-6203-aab8-429c-ac035ff905d0",
      "source": "explanation",
      "text": "«سواه»"
    },
    {
      "id": "7da44f63-4cb4-c79d-4ac4-80a5af7bec84",
      "source": "explanation",
      "text": "«قدوة وإماما للخير»"
    },
    {
      "id": "6f510ff6-25e8-0848-a982-09c25418cdcf",
      "source": "explanation",
      "text": "«الطاعة»"
    },
    {
      "id": "c069f2f4-4043-0233-c5b8-e09ff5e4e53e",
      "source": "explanation",
      "text": "«الواهنة»"
    },
    {
      "id": "4d63611d-ee84-9809-0edb-bcd81fed7f0a",
      "source": "explanation",
      "text": "«ابن مسعود»"
    },
    {
      "id": "1cc9fb32-7441-2bf5-ea1e-d267ad9e7198",
      "source": "explanation",
      "text": "«عقبة بن عامر»"
    },
    {
      "id": "10bd646c-d34c-ab41-147e-0a5d27b7a6b8",
      "source": "explanation",
      "text": "«عامله الله بنقيض قصده»"
    },
    {
      "id": "7242bea4-a5bd-6559-d95f-1a5b3be6f64e",
      "source": "explanation",
      "text": "«عدل رقبة (عتق رقبة)»"
    },
    {
      "id": "35308379-5670-5cf6-2bf4-01d362869250",
      "source": "explanation",
      "text": "«العزائم»"
    },
    {
      "id": "3bab8e81-9112-ec81-9eaf-3bfe54cf70cf",
      "source": "explanation",
      "text": "«الشيطان»"
    },
    {
      "id": "c2a14adb-0100-610e-a5c8-da341d438608",
      "source": "explanation",
      "text": "«المسحور»"
    },
    {
      "id": "8efbe414-030b-94da-fd21-43b316ae0a0f",
      "source": "explanation",
      "text": "«ساحر»"
    },
    {
      "id": "0831673f-d9d3-beff-61d5-da9901236251",
      "source": "explanation",
      "text": "«الصلاة على النبي»"
    },
    {
      "id": "4802c81b-9f3a-b5d0-cdee-ebce523cfb46",
      "source": "explanation",
      "text": "«البومة»"
    },
    {
      "id": "51b62643-f330-5b1c-c5a0-93fffffe4109",
      "source": "explanation",
      "text": "«علامات يهتدى بها»"
    },
    {
      "id": "cf2cfe15-868b-5cb6-4b12-b1a7242bd9a9",
      "source": "explanation",
      "text": "«دخل الجنة»"
    },
    {
      "id": "33c79ed1-d34d-8ec8-90ab-19356959ba12",
      "source": "explanation",
      "text": "«غير منار الأرض»"
    },
    {
      "id": "6239765b-3c79-0f72-7df7-6d8632ee6443",
      "source": "explanation",
      "text": "«الشفاعة بإذنه»"
    },
    {
      "id": "d4e74d12-8b9d-625b-1856-4b8f458758df",
      "source": "explanation",
      "text": "«سحر مثله»"
    },
    {
      "id": "aaeba64a-6965-c291-3f4e-80d5d7c0e643",
      "source": "explanation",
      "text": "«الجاني أو المبتدع»"
    },
    {
      "id": "029f1425-5ec8-1c05-d21b-ec13af1f35b8",
      "source": "explanation",
      "text": "«جائز»"
    },
    {
      "id": "2575946e-70ba-2e7c-3daa-f8d1b649a992",
      "source": "explanation",
      "text": "«هو شرك أصغر/لفظي؛ والصواب: ما شاء الله ثم شئت»"
    },
    {
      "id": "9f928e75-908e-92b1-25d6-67b6c27a58f3",
      "source": "explanation",
      "text": "«نعبدهم»"
    },
    {
      "id": "7b4b13fd-83ea-7f6b-d4e5-558ce37b4324",
      "source": "explanation",
      "text": "«التحليل والتحريم»"
    },
    {
      "id": "29a83d41-8344-0fa1-2da6-28465ba5e4fd",
      "source": "explanation",
      "text": "«صفات النقص»"
    },
    {
      "id": "c215efc0-7fd5-2526-153d-092fd52d6e5a",
      "source": "explanation",
      "text": "«نزول المصائب»"
    },
    {
      "id": "c3392727-5339-0873-d08b-efd125e28b91",
      "source": "explanation",
      "text": "«القضاء والقدر»"
    },
    {
      "id": "ccea4f17-e7ed-bbf2-3dc5-49a7a5a13e18",
      "source": "explanation",
      "text": "«لغير الله»"
    },
    {
      "id": "90c75869-6875-2303-b90c-7443a43c686a",
      "source": "explanation",
      "text": "«دخل الجنة»"
    },
    {
      "id": "0275a719-afbb-f0d9-06e8-2dc9cdf36dd0",
      "source": "explanation",
      "text": "«يدخل النار»"
    },
    {
      "id": "a0cd9a30-0663-ff17-2f92-32ba946394e7",
      "source": "explanation",
      "text": "«شرك»"
    },
    {
      "id": "a3add015-2a87-d1fe-89c2-9ad5be364cb9",
      "source": "explanation",
      "text": "«العين والحمة»"
    },
    {
      "id": "74959bce-d2f2-9144-73b8-10c9972290ba",
      "source": "explanation",
      "text": "«بريء»"
    },
    {
      "id": "b86c4401-c533-81ae-26c6-0d80bcfdb481",
      "source": "explanation",
      "text": "«غير القرآن»"
    },
    {
      "id": "0b57c0bd-0666-e1f9-e03f-a59f92704a0e",
      "source": "explanation",
      "text": "«العين»"
    },
    {
      "id": "040e0de9-8969-8a02-267a-446de187da40",
      "source": "explanation",
      "text": "«التحريم»"
    },
    {
      "id": "b0d7fe00-2b72-a49e-2c28-309dd65fa569",
      "source": "explanation",
      "text": "«كل يوم وليلة»"
    },
    {
      "id": "ee419252-53dc-c1f9-383c-9a3023698050",
      "source": "explanation",
      "text": "«في وصية النبي لمعاذ: «»"
    },
    {
      "id": "07d01f29-b988-4574-8ca1-9cedad8ca864",
      "source": "bank_source_quote",
      "text": "«من ربك؟ وما دينك؟ ومن نبيك؟»"
    },
    {
      "id": "01b52421-bfcb-42b0-9034-591c60e3d641",
      "source": "explanation",
      "text": "«أن تؤمن بالله وملائكته وكتبه ورسله واليوم الآخر والقدر»"
    },
    {
      "id": "be04d3f7-8a37-4530-8555-2c66c59d9970",
      "source": "explanation",
      "text": "«وتؤمن بالقدر خيره وشره»"
    },
    {
      "id": "119d35bc-1357-43b6-a136-0700351ecf99",
      "source": "explanation",
      "text": "«النذر عبادة لا تصرف إلا لله»"
    },
    {
      "id": "9daed191-d0b4-ab7b-83e4-47a315fdd750",
      "source": "explanation",
      "text": "«حقوق النبي في الأصول: 1) الإيمان بنبوته ورسالته 2) محبته أكثر من النفس والأهل والمال 3) طاعته فيما أمر 4) تصديقه فيما أخبر 5) اجتناب ما نهى عنه وزجر 6) ألا يعب"
    },
    {
      "id": "6055629a-ed13-0e3b-c6f4-a94bc014ceb0",
      "source": "explanation",
      "text": "«البضع بكسر الباء: العدد من الثلاثة إلى التسعة»"
    },
    {
      "id": "ab907a81-fd29-4415-f55b-c9feb0449f8e",
      "source": "explanation",
      "text": "«العمل الصالح هو العمل الموافق لسنة رسول الله»"
    },
    {
      "id": "6abbc82b-f777-1486-896d-a5101cc2393e",
      "source": "explanation",
      "text": "«معرفة الله ونبيه ودينه»"
    },
    {
      "id": "d510b762-1fe3-2f22-dd1e-88163a00e52b",
      "source": "explanation",
      "text": "«العصر»"
    },
    {
      "id": "9f0d840c-cbf5-1b33-f54b-3ccc7b0446b8",
      "source": "explanation",
      "text": "«من بلد الشرك إلى بلد الإسلام»"
    },
    {
      "id": "d1612563-8194-6203-ef2a-5131e9299d10",
      "source": "explanation",
      "text": "«على أقدار الله المؤلمة»"
    },
    {
      "id": "02e39da8-d33e-cf41-05c0-0c522fe9f171",
      "source": "explanation",
      "text": "«إفراد الله بالعبادة وترك عبادة ما سواه»"
    },
    {
      "id": "331044a6-06d2-ba91-2958-fcfa40520cde",
      "source": "explanation",
      "text": "«إفراد الله بالعبادة والإعراض عما سواه»"
    },
    {
      "id": "ef35ad7a-6c9d-fac3-ea1f-c2baf59810f7",
      "source": "explanation",
      "text": "«نفي جميع ما يعبد من دون الله»"
    },
    {
      "id": "b01efb63-f4b7-22fc-002a-2b8c93d4f79d",
      "source": "explanation",
      "text": "«إثبات العبادة لله وحده»"
    },
    {
      "id": "57609348-66fa-19c8-6db5-4f13174e5c6e",
      "source": "explanation",
      "text": "«اقرأ»"
    },
    {
      "id": "9218b66d-d695-4c63-bc4d-2cf6ea1419ee",
      "source": "explanation",
      "text": "«وبينهما أمور مشتبهات»"
    },
    {
      "id": "4e0c618e-520b-4511-9a67-5b9f328aa7c3",
      "source": "explanation",
      "text": "«سهل الله له به طريقا إلى الجنة»"
    },
    {
      "id": "8913f815-94e4-4e3c-b899-d09e92d717f8",
      "source": "explanation",
      "text": "«دع ما يريبك إلى ما لا يريبك»"
    },
    {
      "id": "3ba3317a-9fef-4994-9535-07520ea0fdc2",
      "source": "explanation",
      "text": "«كن في الدنيا كأنك غريب أو عابر سبيل»"
    },
    {
      "id": "a2193183-1fae-524d-f67a-aa8201744fa4",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (1- النية)»"
    },
    {
      "id": "6d926dd8-cfe5-8573-4427-38044f6ed8b8",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (28- السنة)»"
    },
    {
      "id": "906b9850-0a26-a499-222b-a33ecde138c5",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (17- الإحسان)»"
    },
    {
      "id": "75664f37-3afd-0dfb-adc9-cd9994b1dc3d",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (4- القدر)»"
    },
    {
      "id": "f1a6c469-15e1-56f0-a44a-06b57f1780d8",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (2- جبريل)»"
    },
    {
      "id": "2f1b3b32-0cdd-7502-4d4b-b946c30534da",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (22- الجنة)»"
    },
    {
      "id": "03b27c61-5b02-557b-596e-9601c22a5e92",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (23- جوامع الخير)»"
    },
    {
      "id": "64a1726d-4b2f-8504-3cfc-b18a7cdc42ee",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (24- فضل الله)»"
    },
    {
      "id": "437ad277-3c89-1263-1b74-9204fbc5f5aa",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (30- الحدود)»"
    },
    {
      "id": "4397f405-8af7-d524-a75f-435909283aac",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (8- الجهاد)»"
    },
    {
      "id": "425762b4-61b3-abfa-d422-cdc225e731a2",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (5- البدعة)»"
    },
    {
      "id": "896c6dfb-64c6-d874-95dc-dee6f3d668cb",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (26- الصدقة)»"
    },
    {
      "id": "cfc9e71a-7c34-4fcb-1e30-b70255ca7f4e",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (27- البر والإثم)»"
    },
    {
      "id": "9e259b14-a48b-93c8-6f84-7cdaf6bcb3c4",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (18- التقوى)»"
    },
    {
      "id": "6a19ccc6-f254-fe98-d63c-81a6dfa1cdda",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (22- الجنة)»"
    },
    {
      "id": "8b5637fa-bb34-d293-074e-057706eaf146",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (22- الجنة)»"
    },
    {
      "id": "91a6c372-020a-6863-2ba6-7e8483517391",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (33- القضاء)»"
    },
    {
      "id": "25e5403b-55ef-a07f-9766-812f0057be86",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (36- طلب العلم)»"
    },
    {
      "id": "8857258e-936b-5493-f566-1ad754f6fa30",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (9- السؤال)»"
    },
    {
      "id": "d2a20a31-fd50-ad5c-5b27-54c2ae1671f0",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (2- جبريل)»"
    },
    {
      "id": "4fb3f9eb-7397-0855-30d8-8a6bfd82d626",
      "source": "explanation",
      "text": "«نعم، أن أوامر الله قسمان فريضة ونافلة»"
    },
    {
      "id": "5e7bae87-bd7d-512c-9c59-70167b1259ee",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (33- القضاء)»"
    },
    {
      "id": "099f23ff-6051-2d9f-41cb-9c23238361e6",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (6- الشبهات)»"
    },
    {
      "id": "846fe9ec-4924-a41a-70e4-c51a9507d649",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (13- المحبة)»"
    },
    {
      "id": "5a98a349-c5d8-544b-49ec-ee151c7a6fc4",
      "source": "explanation",
      "text": "«هذه من فوائد حديث (15- الأخلاق)»"
    },
    {
