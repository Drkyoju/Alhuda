    },
    {
      "id": "776a51ad-a027-f148-83e0-67d340e03717",
      "source": "explanation",
      "text": "«النية والإخلاص»"
    },
    {
      "id": "e7f55baf-38ae-a3d0-9b22-518a907121f7",
      "source": "explanation",
      "text": "«الإسلام والإيمان والإحسان»"
    },
    {
      "id": "075d3586-414b-bfbc-263d-055b1319e4e5",
      "source": "explanation",
      "text": "«أربعين يوما نطفة»"
    },
    {
      "id": "6390fbbb-4776-88a6-95d5-3ac50f8941d5",
      "source": "explanation",
      "text": "«الله وكتابه ورسوله وأئمة المسلمين وعامتهم»"
    },
    {
      "id": "76f476ff-04be-4845-49fb-df97aaceacf7",
      "source": "explanation",
      "text": "«الزهد»"
    },
    {
      "id": "d4161bab-404d-2657-a0ed-267ce6957756",
      "source": "explanation",
      "text": "«كأنك تراه فإن لم تكن تراه فإنه يراك»"
    },
    {
      "id": "163a1e55-0fb2-4467-5564-2d0bff81f49c",
      "source": "explanation",
      "text": "«الصادق المصدوق»"
    },
    {
      "id": "ec222f45-8bbf-390a-fa68-3ad07048f867",
      "source": "explanation",
      "text": "«قدسي»"
    },
    {
      "id": "1ee43245-3fe9-14ea-1e14-6805cad62a82",
      "source": "explanation",
      "text": "«رفع الحرج»"
    },
    {
      "id": "18aa1c12-194c-29fe-ca5f-31ccf419f8ee",
      "source": "explanation",
      "text": "«عمر بن الخطاب رضي الله عنه»"
    },
    {
      "id": "b4abc0b2-0328-2c30-3a76-547e37e538c6",
      "source": "explanation",
      "text": "«الثالثة والعشرين من الهجرة»"
    },
    {
      "id": "337ce515-4aa6-9d2a-28ae-08795f2bc485",
      "source": "explanation",
      "text": "«مع أبيه بمكة وهو صغير»"
    },
    {
      "id": "40de4c27-f6cc-b509-95fc-a186a2a2e4f9",
      "source": "explanation",
      "text": "«عبد الله بن مسعود رضي الله عنه»"
    },
    {
      "id": "bb75112b-febb-9faa-7c11-71a057a47a74",
      "source": "explanation",
      "text": "«الحبشة ثم المدينة»"
    },
    {
      "id": "7b36acc7-c89d-5910-daad-5a9114b76e9f",
      "source": "explanation",
      "text": "«أبو هريرة وابن عباس على الترتيب»"
    },
    {
      "id": "b36bcaec-d7b7-7b96-abe1-1a2e16cba89c",
      "source": "explanation",
      "text": "«العزم على فعل العبادة تقربا إلى الله وحمله بالحق»"
    },
    {
      "id": "963542fc-c630-6925-1386-98fe6d5a097e",
      "source": "explanation",
      "text": "«خرج علينا»"
    },
    {
      "id": "a849f4ad-9b6f-4ff0-52ef-e2c8b4ad68de",
      "source": "explanation",
      "text": "«أنه لا يعرف من الصحابة وفيه غرابة»"
    },
    {
      "id": "4336ca8e-6857-af62-9d20-dbb932298be9",
      "source": "explanation",
      "text": "«المملوكة»"
    },
    {
      "id": "8a6f4c97-74bc-18ca-a752-ca26b0d2f948",
      "source": "explanation",
      "text": "«الفقراء»"
    },
    {
      "id": "2d138f54-6f13-6935-33d2-146edf167b2e",
      "source": "explanation",
      "text": "«الاستسلام لله بالتوحيد والانقياد له بالطاعة والبراءة من الشرك»"
    },
    {
      "id": "90740421-cfa1-e46f-042e-73d598f0c7b0",
      "source": "explanation",
      "text": "«أعلنت عليه الحرب»"
    },
    {
      "id": "1b0f4867-ddf6-9c9f-08e7-6553f70bcf05",
      "source": "explanation",
      "text": "«أداء الفرائض»"
    },
    {
      "id": "9ab05330-bb0d-27e5-72fe-c230e166c37d",
      "source": "explanation",
      "text": "«ما يرتكبه الإنسان من العمل من غير عمد»"
    },
    {
      "id": "24298053-bdf7-d3bc-f61c-0586b69520de",
      "source": "explanation",
      "text": "«ذهول القلب عن شيء معلوم من قبل»"
    },
    {
      "id": "34a96b6d-df2b-caa0-0b90-96edf2b022f4",
      "source": "explanation",
      "text": "«الخطأ والنسيان والإكراه»"
    },
    {
      "id": "6dd9abd3-21db-3bb7-5430-76d389915cc8",
      "source": "explanation",
      "text": "«أئمة المسلمين وعامتهم»"
    }
  ],
