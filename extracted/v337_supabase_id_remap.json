      "local": "769249a0-e86d-71e2-b22b-6615bcf37391",
      "cloud": "7c5070d9-a5d4-4ed6-b5f5-83c54a6b2da9",
      "source_quote": "بني الإسلام على خمس: شهادة أن لا إله إلا الله"
