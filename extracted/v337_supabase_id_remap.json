    {
      "local": "41b189f4-a2e6-43a3-ba4f-e27fb4f6627b",
      "cloud": "41b189f4-a2e6-43a3-ba4f-e27fb4f6627b",
      "source_quote": "احفظ الله يحفظك؛ احفظ الله تجده تجاهك"
    },
    {
      "local": "f7731378-0f5e-38b5-e757-b5852091bd54",
      "cloud": "8f2e341e-f79d-4e6d-8caf-581ba5c4bd60",
      "source_quote": "عمر بن الخطاب — راوي حديث: إنما الأعمال بالنيات"
    },
