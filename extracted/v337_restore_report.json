  "examples": [
    {
      "id": "53c4fad7-c99a-31c3-8200-b25822879097",
      "text": "من حلف بالله فليصدق، ومن حلف له بالله فليرض، ومن لم يرض فليس من الله",
      "q": "من حلف بالله فليصدق، ومن حلف له بالله؟"
    },
    {
      "id": "684a6d62-7429-426d-cf3e-3c721a563763",
      "text": "العطف بالواو يقتضي الجمع والمساواة، والعطف بثم يقتضي الترتيب والتراخي",
      "q": "العطف ب\"ثم\" يقتضي:"
    },
    {
      "id": "bbf392cb-a947-1661-ccbd-d9890511efa0",
      "text": "نهي النبي عن اتخاذ القبور مساجد؛ واتخاذ المساجد على القبور من الغلو",
      "q": "بناء المساجد على القبور والإسراج عليها من:"
    },
    {
      "id": "76230816-1cbf-f6ad-a143-4893c85c06d2",
      "text": "وهو العلي الذي له علو القدر وعلو القهر وعلو الذات",
      "q": "\"وهو العلي\" تتضمن لله علو:"
    },
    {
      "id": "b08eb9e5-c85b-bee6-49f1-3884c5fdee40",
      "text": "عن أبي شريح أنه كان يكنى أبا الحكم فقال له النبي: إن الله هو الحكم وإليه الحكم",
      "q": "غير النبي اسم الرجل المكنى بأبي الحكم لأن الحكم:"
    },
    {
      "id": "64a9e304-8824-26b7-87f4-0446e6d27f2e",
      "text": "تكنية الرجل بأكبر بنيه",
      "q": "يكنى الرجل بأكبر:"
    },
    {
      "id": "c5ff45cf-4f0e-2987-468b-50ced07cae70",
      "text": "نخوض ونلعب ولم نقصد الاستهزاء والتكذيب وإنما قصدنا الخوض في الحديث واللعب",
      "q": "اعتذر المنافقون بأنهم كانوا:"
    },
    {
      "id": "3460b2d5-3198-5ec6-517b-ec6fd26de2bc",
      "text": "التنجيم نوع من أنواع السحر؛ والاستدلال بالنجوم على الحوادث المستقبلة من ادعاء علم الغيب",
      "q": "التنجيم: الاستدلال بالأحوال الفلكية على الحوادث الأرضية، وتع"
    },
    {
      "id": "03806160-f513-42c2-26e6-ba9fa2647058",
      "text": "باب من الإيمان بالله الصبر على أقدار الله",
      "q": "الصبر على أقدار الله المؤلمة:"
    },
    {
      "id": "b5fecca4-b8fe-63ec-28fd-4087d1f6a403",
      "text": "ثم قام رجل آخر فقال ادع الله أن يجعلني منهم فقال: سبقك بها عكاشة",
      "q": "الذي سبق عكاشة إلى دعوة \"اجعلني منهم\":"
    },
    {
      "id": "40379489-f48b-7857-597c-405eca3332e8",
      "text": "اللات اسم لرجل كان يلت السويق للحاج فمات فعكفوا على قبره",
      "q": "\"اللات\" في الأصل كان رجلا:"
    },
    {
      "id": "478be838-386d-07f2-f07c-1767b52f48d2",
      "text": "كان يلت السويق للحاج فمات فعكفوا على قبره",
      "q": "\"اللات\" كان رجلا يلت السويق للحجاج ثم عكف على:"
    },
    {
      "id": "b201f59b-1cba-a14f-0994-98c5076d18c4",
      "text": "لا تحلفوا بآبائكم؛ من حلف بالله فليصدق، ومن حلف له بالله فليرض",
      "q": "\"لا تحلفوا بآبائكم، من حلف بالله\":"
    },
    {
      "id": "da9c7827-2b87-6681-f91b-52c8291fd87a",
      "text": "من حلف بالله فليصدق، ومن حلف له بالله فليرض، ومن لم يرض فليس من الله",
      "q": "من حلف له بالله فعليه أن؟"
    },
    {
      "id": "b5c332c6-99b0-c89f-97ed-837e4c1db634",
      "text": "من حلف بالله فليصدق، ومن حلف له بالله فليرض",
      "q": "\"من حلف بالله\" — فعليه أن:"
    }
  ]
