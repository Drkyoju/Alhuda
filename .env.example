# Supabase project URL (public — safe to commit; protected by RLS).
SUPABASE_URL=https://smcyaqwxbmhshhhhdece.supabase.co

# Supabase key. For server-side scripts (scripts/apply_*.py) use a SERVICE ROLE
# key from Supabase → Project Settings → API → service_role secret. NEVER commit
# this value. For client-side (app.js) the publishable anon key is already in
# the bundle — RLS enforces access control. CranL does not need SUPABASE_* in
# Environment for the SPA (browser talks to Supabase directly).
SUPABASE_KEY=replace-me-with-service-role-key
# Optional alias used by some scripts:
# SUPABASE_ANON_KEY=sb_publishable_...

# ── CranL / Node server.mjs (set in CranL → Environment, never commit) ──
# FISH_API_KEY=
# FISH_VOICE_ID=aa9c8260269c411d9863ab1b1bfa3158
# AUTH_NAME_PEPPER=
# PORT=3000
# HOST=0.0.0.0
# Optional Fish tuning (same as fish-audio-tts.js):
# FISH_TTS_SPEED=
# FISH_TTS_VOLUME=
# FISH_TTS_MODEL=s2.1-pro
# Optional absolute HTTPS origin (Azure lexicon / share helpers):
# PUBLIC_APP_URL=https://alhuda-zi6bbd.cranl.net

# Optional override for the source quiz_app.html used by sync scripts.
# Defaults to <project>/quiz_app.html or the first CLI argument.
# QUIZ_HTML=/absolute/path/to/quiz_app.html
